# DARPAN Environment Configuration

# Server Configuration
PORT=3000
NODE_ENV=development

# Security
JWT_SECRET=darpan-secret-key-2024-production
JWT_EXPIRATION=24h

# Database
DB_PATH=./darpan.db

# CORS
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info